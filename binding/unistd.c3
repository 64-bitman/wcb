module wcb::binding::unistd @private;

// Constants
const int STDIN_FILENO = 0;
const int STDOUT_FILENO = 1;
const int STDERR_FILENO = 2;
const int R_OK = 4;
const int W_OK = 2;
const int X_OK = 1;
const int F_OK = 0;
const int SEEK_SET = 0;
const int SEEK_CUR = 1;
const int SEEK_END = 2;
const int L_SET = 0;
const int L_INCR = 1;
const int L_XTND = 2;
const int F_ULOCK = 0;
const int F_LOCK = 1;
const int F_TLOCK = 2;
const int F_TEST = 3;

// Type Aliases & Callbacks
alias GidT = uint;
alias UidT = uint;
alias OffT = CLong;
alias UsecondsT = uint;
alias PidT = int;
alias SocklenT = uint;

