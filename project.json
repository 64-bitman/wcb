{
    "authors": [ "Foxe Chen <chen.foxe@gmail.com>" ],
    "output": "build",
    "script-dir": ".",
    "exec-dir": ".",
    "test-sources": [
        "src/core/**",
        "src/io/**",
        "test/**",
        "binding/**",
        "build/client_protocol.c3",
//      "build/server_protocol.c3"
    ],
    "c-sources": [ "src/io/interop.c" ],
    "cflags": "-O0 -ggdb3",
    "targets": {
        "wcb_scanner": {
            "type": "executable",
            "sources": [
                "src/scanner/**",
            ]
        },
        "protocol": {
            "type": "prepare",
            "depends-on": [ "wcb_scanner" ],
            "exec": [
                "build/wcb_scanner \"wcb::protocol\" client src/protocol/wayland.xml build/client_protocol.c3",
                "build/wcb_scanner \"wcb::protocol\" server src/protocol/wayland.xml build/server_protocol.c3"
            ]
        },
        "wcb": {
            "type": "source-lib",
            "depends-on": [ "protocol" ],
            "sources": [
                "src/core/**",
                "src/io/**",
                "build/client_protocol.c3",
                "build/server_protocol.c3"
            ]
        },
        "example_list_globals": {
            "type": "executable",
            "depends-on": [ "protocol", "wcb_scanner" ],
            "sources": [
                "src/core/**",
                "src/io/**",
                "binding/**",
                "build/client_protocol.c3",
                "examples/list_globals.c3"
            ]
        }
    }
}
// vim: ft=jsonc
